# Copy to .env and adjust. .env is gitignored — never commit real values.

# HTTP port the server listens on.
# Render injects its own PORT — the app reads it via os.LookupEnv.
PORT=8090

# development | production
ENV=development

# --- Database ---
# LOCAL (docker compose): sslmode=disable is fine.
DATABASE_URL=postgres://url:url@localhost:5432/url?sslmode=disable
#
# NEON / PRODUCTION: use sslmode=require (Neon enforces TLS).
# Example:
# DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Connection pool (optional; sane defaults in code) ---
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_CONN_MAX_LIFETIME_MIN=5
